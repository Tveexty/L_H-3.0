# ==================== Luma Ai Nitrogen (.env) ====================
# По умолчанию настроено на локальный Ollama (Qwen 2.5 3B или Llama 3.2 3B)
BASE_URL=http://127.0.0.1:11434/v1
API_KEY=ollama
MODEL_NAME=qwen2.5:3b
# Альтернатива локальной модели:
# MODEL_NAME=llama3.2:3b

# Эмбеддинги для RAG (если модели нет — автоматически работает встроенный 384-dim векторизатор)
EMBED_MODEL=nomic-embed-text

# Примеры облачных OpenAI-совместимых провайдеров (достаточно раскомментировать):
# --- Google Gemini Flash-Lite ---
# BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# API_KEY=YOUR_GEMINI_API_KEY
# MODEL_NAME=gemini-2.5-flash-lite
#
# --- Groq ---
# BASE_URL=https://api.groq.com/openai/v1
# API_KEY=YOUR_GROQ_API_KEY
# MODEL_NAME=llama-3.1-8b-instant
#
# --- OpenRouter ---
# BASE_URL=https://openrouter.ai/api/v1
# API_KEY=YOUR_OPENROUTER_API_KEY
# MODEL_NAME=google/gemini-2.0-flash-lite-001

# Агрессивная 3-уровневая память (SQLite WAL + Vector Store, без лимита объёма на диске)
SHORT_TERM_WINDOW=28
TEMPERATURE=0.55

# Мост к ядру Luma OS (Календарь, Телеметрия, Office Studio, Luma Обвести для поиска)
LUMA_KERNEL_URL=http://127.0.0.1:49216
NITROGEN_HOST=127.0.0.1
NITROGEN_PORT=49225
