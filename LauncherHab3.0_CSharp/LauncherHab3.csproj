<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>LauncherHab3</RootNamespace>
    <AssemblyName>LauncherHab3.0</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>12.0</LangVersion>
    <Version>3.0.0</Version>
    <Title>LauncherHub 3.0 — Luma Core 1.0 (C# .NET 8)</Title>
    <Company>Luma Core Architecture</Company>
    <Product>LauncherHub 3.0 + Luma System 1.0</Product>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- Исключаем дублирующиеся и внешние директории из компиляции MSBuild -->
  <ItemGroup>
    <Compile Remove="public\**;..\public\**;bin\**;obj\**" />
    <EmbeddedResource Remove="public\**;..\public\**;bin\**;obj\**" />
    <None Remove="public\**;..\public\**;bin\**;obj\**" />
    <Page Remove="public\**;..\public\**;bin\**;obj\**" />
  </ItemGroup>

</Project>
